# ====================================================================
# SONIQ STORE — ENVIRONMENT VARIABLES
# ====================================================================

# 1. DATABASE CONFIGURATION (Сонголт 1: Supabase - Зөвлөмж болгож буй)
# https://supabase.com дээр New Project үүсгэн schema.sql ажиллуулсны дараа
# Project Settings -> API хэсгээс хуулж авна:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Сонголттой (Client талд ашиглах бол):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Сонголт 2: PostgreSQL / Neon DB)
# Хэрэв Supabase ашиглахгүй шууд PostgreSQL холбох бол:
# DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------------
# 3. CLOUDFLARE R2 STORAGE (1GB+ том файлууд байршуулах)
# Админ самбарын "Дэлгүүрийн тохиргоо" цэснээс эсвэл эндээс тохируулж болно:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=soniq-store
# R2_PUBLIC_DOMAIN=https://files.soniq.click
